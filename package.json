{
  "name": "sephiro",
  "version": "0.4.1",
  "private": true,
  "description": "A lightweight monorepo for the Sephiro UI system and visual playground.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "validate:commit": "node scripts/validate-commit-message.mjs",
    "prepare": "lefthook install",
    "check": "bun run check:ui && bun run check:playground",
    "check:ui": "bun --cwd packages/ui check",
    "check:playground": "bun --cwd apps/playground check",
    "test": "bun --cwd packages/ui test",
    "build": "bun run build:ui && bun run build:playground",
    "build:ui": "bun --cwd packages/ui build",
    "build:playground": "bun --cwd apps/playground build",
    "dev": "bun --cwd apps/playground dev",
    "dev:ui": "bun --cwd packages/ui dev",
    "dev:playground": "bun --cwd apps/playground dev",
    "release": "bun scripts/release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "lefthook": "^2.1.14"
  }
}
