{
  "name": "@zovaris/sephiro",
  "version": "0.6.0",
  "description": "Reusable desktop UI primitives for React and Preact applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zovaris/sephiro.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./components.css": "./dist/components.css",
    "./themes.css": "./dist/themes.css"
  },
  "scripts": {
    "build": "tsup && bun run build:css",
    "build:css": "node scripts/build-css.mjs",
    "check": "tsc --noEmit",
    "dev": "bun run --parallel dev:js dev:css",
    "dev:js": "tsup --watch",
    "dev:css": "node scripts/build-css.mjs --watch",
    "test": "bun test"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19",
    "postcss": "^8.5.28",
    "preact": "^10.26.4",
    "react-dom": "^19",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "cn": "^0.3.0",
    "sonner": "^2.0.5"
  }
}
