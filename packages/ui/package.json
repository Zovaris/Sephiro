{
  "name": "@sephiro/ui",
  "version": "0.2.0",
  "private": true,
  "description": "Reusable desktop UI primitives for React and Preact applications.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "scripts": {
    "build": "tsup && bun run build:css",
    "build:css": "tailwindcss --input src/styles.css --output dist/index.css",
    "check": "tsc --noEmit",
    "dev": "bun run --parallel dev:js dev:css",
    "dev:js": "tsup --watch",
    "dev:css": "tailwindcss --input src/styles.css --output dist/index.css --watch",
    "test": "bun test"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19",
    "preact": "^10.26.4",
    "react-dom": "^19",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "cn": "^0.3.0"
  }
}
